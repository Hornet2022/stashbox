# Stashbox 后端环境变量样板（CP3.5+ 真 LLM / TTS / OSS）
#
# ⚠️ 这是模板，不要把真实凭证提交进 git。
#   真实凭证请复制本文件为 .env 后填写：cp .env.example .env
#   .env 已被 stashbox/.gitignore 排除（第 11-14 行）。
#
# 用法：
#   1. cp .env.example .env
#   2. 编辑 .env，替换占位符 xxx-... 为真实值
#   3. 从 backend/ 目录启动服务（pydantic-settings 会自动读 .env）
#
# 当前策略（CP9.x 决策）：
#   - LLM：全 OpenAI 协议栈（mock / openai / qwen_vl 三选一，无 claude）
#   - TTS：火山方舟 ARK（OpenAI 兼容） 或 WebSocket 豆包（流式备选）
#   - LLM 与 TTS 的 OPENAI_API_KEY 已拆为 OPENAI_LLM_API_KEY / OPENAI_TTS_API_KEY

# ─── 运行环境 ───────────────────────────────────────────────────────────
STASHBOX_ALLOW_DEV_JWT=1
JWT_SECRET=dev-secret-change-me-in-production
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ─── LLM（蒸馏 Step1 结构化 / Step2 改写）─────────────────────────────
# 全 OpenAI 协议栈：mock / openai / qwen_vl
# 当前推荐：qwen_vl（阿里 token-plan 团队版，OpenAI 兼容）
LLM_PROVIDER=qwen_vl

# Qwen-VL（阿里 token-plan 团队版，Step1 多模态结构化，OpenAI 兼容）
# 端点: https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 控制台: https://token-plan.console.aliyun.com/  → API Key
QWEN_VL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-xxx
QWEN_VL_MODEL=qwen3.6-flash

# OpenAI 兼容 LLM（OpenAI 官方 / 任何 OpenAI-compatible 端点）
# 切 LLM_PROVIDER=openai 时生效
OPENAI_LLM_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_API_KEY=sk-xxx
OPENAI_LLM_MODEL=gpt-4o-mini

# LLM 通用：超时 / 重试
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ─── TTS（蒸馏 Step3）────────────────────────────────────────────────
# 选一个：mock / edge / openai / doubao
# 当前推荐：openai + 火山方舟 ARK（同 OpenAI 协议栈，HTTP 简单、无需 WebSocket 帧）
TTS_PROVIDER=openai

# OpenAI 协议 TTS（兼容：OpenAI 官方 / Azure OpenAI — 注意 ⚠️ 不兼容火山 Coding Plan TTS）
# 鉴权：Authorization: Bearer <OPENAI_TTS_API_KEY>
#
# ⚠️ 火山方舟 Coding Plan 语音模型走 openspeech.bytedance.com，**不是** ARK OpenAI 端点
# Coding Plan 用户请用 TTS_PROVIDER=doubao（见下方"备选 1"）而非 TTS_PROVIDER=openai
#
# 真 OpenAI 官方：https://api.openai.com/v1，模型 tts-1 / tts-1-hd，音色 alloy/echo/fable/onyx/nova/shimmer
OPENAI_TTS_API_KEY=xxx                  # 真 OpenAI sk-... 或 Azure key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# 备选 1：豆包 TTS（CP9.x：火山方舟 Coding Plan，HTTP POST 单向流式）
# 端点: https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
# 鉴权: X-Api-Key + X-Api-Resource-Id (Coding Plan 专属)
# 控制台: https://console.volcengine.com/ark → Coding Plan → 我的订阅 → 使用配置
# 模型: doubao-seed-tts-2.0（控制台 → 模型配置 → 豆包语音合成模型 2.0）
# 音色: 控制台 → 音色库 复制实际 speaker ID（不是 BV001_streaming）
# 旧版 APP_ID/TOKEN（DOUBAO_TTS_APP_ID / DOUBAO_TTS_TOKEN）保留兼容，优先用 API_KEY
# TTS_PROVIDER=doubao
# DOUBAO_TTS_API_KEY=xxx                   # Coding Plan 专属 API Key（新）
# DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0      # 模型版本/计费方式（新）
# DOUBAO_TTS_VOICE=zh_female_xxx           # 音色 ID（控制台 → 音色库 查实际可用）
# DOUBAO_TTS_APP_ID=xxx                    # 旧版兼容
# DOUBAO_TTS_TOKEN=xxx                     # 旧版兼容

# 备选 2：Microsoft Edge TTS（免费、无需 key）
# pip install edge-tts
# TTS_PROVIDER=edge
# EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ─── 阿里云 OSS（Step4 拼接产物上传）─────────────────────────────────
# 仅在需要把音频上传到 OSS 时配；只跑蒸馏 step1-4 可空着（产物落本地临时目录）
# ⚠️ 生产（真实 S3 / SeaweedFS）必须显式写 oss，别照抄下面这行的 local。
# 2026-10-02：生产 .env 曾整份缺这一行，于是 storage 工厂取缺省值去本地盘
# 找 SeaweedFS 里的音频 → 多码率转码 100% 静默失败。缺省值现已统一为 oss，
# 但显式写出来才能一眼看出这台机器用的哪个后端。
STORAGE_PROVIDER=local                  # local = 本地开发/真机测试；生产写 oss
LOCAL_AUDIO_DIR=/tmp/audio              # 音频落地目录（默认 /tmp/audio）
# CP9.x：Android 真机/模拟器访问 audio_url 的 base；emulator→10.0.2.2，真机→局域网 IP
LOCAL_STORAGE_PUBLIC_URL=http://10.0.2.2:8100/audio

# OSS（生产用；本地测试可空着）
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=stashbox-audio               # ⚠️ 历史上曾叫 OSS_BUCKET_NAME，已统一为 OSS_BUCKET
OSS_ACCESS_KEY_ID=xxx
OSS_ACCESS_KEY_SECRET=xxx

# CP9.x：api-gateway 在 STORAGE_PROVIDER=local 时自动挂 /audio/ 静态路由
# 生产可显式置 0 关掉；默认跟随 STORAGE_PROVIDER
ENABLE_LOCAL_AUDIO_MOUNT=1

# ─── 跨域白名单（admin-web 必需；不配会踩坑）─────────────────────────
# CORS_ALLOW_ORIGINS=* 不推荐；请填具体 admin-web origin
# 例如本地开发：http://localhost:5173
STASHBOX_CORS_ALLOW_ORIGINS=http://localhost:5173

# ─── Arq Worker（ai-service 蒸馏队列）────────────────────────────────
# 本地开发：起 Redis（brew services start redis 或 docker run -d -p 6379:6379 redis:7-alpine）
REDIS_URL=redis://localhost:6379/0
ARQ_MAX_JOBS=4                  # 并发 worker 数
ARQ_JOB_TIMEOUT=1800            # 单任务超时（秒），30 分钟
ARQ_RESULT_TTL=86400            # 任务结果保留（秒），1 天
ARQ_RETRY_MAX=2                 # 失败重试次数（不含首次执行）

# ─── 可观测性（可选）─────────────────────────────────────────────────
# Langfuse 蒸馏链路埋点；不配默认关闭
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com