# Stashbox 后端 —— 生产环境变量模板（**2 GiB 轻量应用服务器**专用）
# ======================================================================
#
# 这是 `.env.production.example` 的**第二份**模板，不是它的替代品：
#   .env.production.example   通用生产模板（Docker / ACK / 大机器）
#   .env.production.2g.example 本文件 —— 2 vCPU / 2 GiB / 40 GiB 轻量应用服务器
#
# 两者差在哪、为什么差，本文件每个变量后面都写了理由。
#
# 用法：
#     sudo install -m 0640 -o root -g stashbox \
#          .env.production.2g.example /etc/stashbox/stashbox.env
#     sudo vi /etc/stashbox/stashbox.env        # 填密钥
#     ./preflight.sh /etc/stashbox/stashbox.env # 必须 0 FAIL
#
# ⚠️ 本文件**不含任何真实凭证**，全是空值或明显占位符 —— 必须逐项填。
# ⚠️ 填完的 .env.production.2g 已被 .gitignore 排除，提交前确认 git status。
#
# 与通用模板的**关键差异**（一眼版）：
#   TTS_PROVIDER=edge        不加载任何模型，0 RAM
#   ARQ_MAX_JOBS=2           2 vCPU 的并发上限
#   POSTGRES_POOL_SIZE=4     5 个进程 × 连接池不能把 max_connections 撑爆
#   STASHBOX_FETCH_BROWSER_TIER=0  chromium 300MB+，2 GiB 放不下
#   OSS_ENDPOINT=...-internal 内网端点，不产生公网流量费
#   ENABLE_LOCAL_AUDIO_MOUNT=0  音频在 OSS，40GB 盘只放 OS + PG + 日志
#   LANGFUSE_ENABLED=false   云监控 / SLS 足够，不再引入一套埋点后端
#   FORWARDED_ALLOW_IPS      与 TRUSTED_PROXY_IPS **必须完全一致**

# ─────────────────────────────────────────────────────────────────────
# 运行环境
# ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=prod
LOG_LEVEL=INFO
TZ=Asia/Shanghai
# 生产必须 false：true 会把每条 SQL 打进日志（日志量 ×50，journald 撑不住）。
DEBUG=false

# 必填。>= 16 字符。生成：openssl rand -hex 32
# ⚠️ 不能是 dev 默认值（会被拒绝启动）。
# ⚠️ 换密钥 = 所有已签发 token 立即失效（用户要重新登录）。内测期固定一个。
JWT_SECRET=

# 选填。第三方回调（微信公众号服务号 / clawbot）的共享密钥。
# 空 = 回调端点一律 503 拒绝（fail-closed）。
CALLBACK_SHARED_SECRET=

# ─────────────────────────────────────────────────────────────────────
# PostgreSQL（**本机**实例，不是托管 RDS）
# ─────────────────────────────────────────────────────────────────────
# 这台机器上跑本机 PostgreSQL（tune-host.sh 已调好 postgresql.conf）：
# 托管 RDS 要额外掏钱，而 2 GiB 的机器本来就得省内存 —— 本机 PG 调优后
# 空载 RSS 约 200-300 MB，和托管实例的连接延迟也省了。
#
# 必填。127.0.0.1 = 只连本机（PG 不对外暴露）。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# 必填。账号（建库见 deploy/README.md 的「2 GiB 机器怎么部」）。
POSTGRES_USER=
# 必填。密码。
POSTGRES_PASSWORD=
# 必填。库名。
POSTGRES_DB=

# ⚠️ 2 GiB 专用：连接池**必须**调小。
#   common/database.py 里 max_overflow 是写死的 10，所以每个进程最坏会开
#   pool_size + 10 条连接。默认 pool_size=10 的话，5 个进程最坏 100 条 ——
#   而 tune-host.sh 把 max_connections 设成了 40（每条连接 5-8MB，
#   再多就把内存吃光，PG 先被 OOM kill）。
#   4 × 5 个进程 = 20 条常驻连接，剩下 20 条留给突发和运维。
POSTGRES_POOL_SIZE=4
POSTGRES_POOL_RECYCLE=3600

# ─────────────────────────────────────────────────────────────────────
# Redis（**本机**实例）
# ─────────────────────────────────────────────────────────────────────
# 本机 Redis 干三件事：缓存、配额/限流状态、Arq 蒸馏队列。
# tune-host.sh 已经写了 maxmemory=96mb + maxmemory-policy=volatile-lru。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 必填。密码 —— **必须与 tune-host.sh 写进 redis.conf 的 requirepass 一致**。
#   tune-host.sh 是从**这个文件**里读 REDIS_PASSWORD 写进 redis.conf 的，
#   所以顺序是：先填这里 → 再跑 tune-host.sh → 再起 redis。
#   无认证的 Redis = 限流状态 / 封禁状态 / 队列任何人都能读写。
REDIS_PASSWORD=
# 必填。Arq worker **只**读这个变量，不看上面的 REDIS_*。
#   必须与上面 4 项指向同一个实例，否则 worker 起着、不报错、任务没人消费。
#   格式：redis://[:密码@]host:port/db
REDIS_URL=

# ─────────────────────────────────────────────────────────────────────
# 网关接线（同机，走回环）
# ─────────────────────────────────────────────────────────────────────
# 5 个服务都在这台机器上，用 127.0.0.1 —— 不走公网也不走 VPC 内网。
USER_SERVICE_URL=http://127.0.0.1:8101
CONTENT_SERVICE_URL=http://127.0.0.1:8102
AI_SERVICE_URL=http://127.0.0.1:8103

# 必填。对外可达的地址前缀（客户端拿到的音频 URL 等会拼它）。
PUBLIC_GATEWAY_URL=https://api.stashbox.cn

# 必填。跨域白名单，逗号分隔的 origin（不带路径、不带末尾斜杠）。
#   ⚠️ ENVIRONMENT=prod 时不配 → 网关**启动即失败**（有意的门禁）。
#   这里只放**运营后台**的 origin。安卓客户端是原生应用，不走 CORS。
STASHBOX_CORS_ALLOW_ORIGINS=https://admin.stashbox.cn

# 选填。网关 → 下游的调用超时（秒），默认 60。
# ⚠️ **必须大于** STASHBOX_CAPTURE_FETCH_BUDGET（默认 30）：网关的剪藏请求是
#   同步的，后端抓完文章才能返回。网关先超时 = 客户端拿到裸 500，
#   而后端还在后台抓 —— 用户以为失败了，重试又来一次，越超时越多。
#   30（抓取预算）+ 15（解析/落库/拼音频的尾巴）= 45。
#   nginx 的 proxy_read_timeout（90s）也必须大于这个值，见 deploy/systemd/nginx.conf。
STASHBOX_GATEWAY_UPSTREAM_TIMEOUT=45

# ─────────────────────────────────────────────────────────────────────
# 真实客户端 IP：两个信任边界，必须一致
# ─────────────────────────────────────────────────────────────────────
# 必填（生产）。**应用层**的可信代理列表（backend/common/ip.py 用它）。
#   peer 不在列表里 → 忽略 X-Forwarded-For，只认真 peer（防伪造）。
#   peer 在列表里 → 信任 XFF，取最左边那个不在列表里的地址。
#
# ⚠️ 为什么不能填 "*"：
#   "*" = 任何来源的 X-Forwarded-For 都采信 → 公网客户端可以随便伪造一个
#   来源 IP，登录限流（按 IP 计数）形同虚设；反过来，如果上游把所有请求
#   都归到同一个代理 IP，**所有人算一个 IP** —— 一个人刷爆就能把其他人
#   全锁在门外。两种坏结果都直接命中登录限流。
#
# 本拓扑（nginx 与网关**同机**）：nginx 是网关的唯一上游，peer 恒为 127.0.0.1
#   → 填 127.0.0.1。
# 换拓扑（SLB / Ingress 在别的机器上）：填**那个代理的网段**，例
#   TRUSTED_PROXY_IPS=47.98.0.0/16
#   并且 nginx 侧要配 set_real_ip_from（见 deploy/systemd/nginx.conf）。
TRUSTED_PROXY_IPS=127.0.0.1

# 必填。**ASGI 层**的可信代理列表 —— uvicorn 的 ProxyHeadersMiddleware 用它。
#   uvicorn 会在 ASGI 层就把 scope["client"] 改写成 XFF 里的地址，
#   **在应用代码看到请求之前就已经改了**。
#
# ⚠️ 必须与 TRUSTED_PROXY_IPS **完全一致**：
#   这两层是同一个决定的两个实现。不一致 → 网关和下游对"这个 IP 是谁"的
#   理解不同 → 限流按 A 计数、审计按 B 记，永远对不上；
#   代理在另一台机器时，所有人算一个 IP，一个人能锁死所有人。
#   preflight.sh 会检查这一对，不一致直接 FAIL。
#
# uvicorn 的默认值是 127.0.0.1,::1（这里只写 127.0.0.1，因为 nginx 上游
#   写的是 127.0.0.1）。如果把服务也绑到 ::1，两边都要加上 ::1。
FORWARDED_ALLOW_IPS=127.0.0.1

# ─────────────────────────────────────────────────────────────────────
# 登录限流（user-service）
# ─────────────────────────────────────────────────────────────────────
# 必填（公网未鉴权端点）。wechat-login 任意 code 都能建号 → 必须限流，
#   否则一次循环就能建出海量账号（每个号自带免费配额）。
#   阈值按**真实客户端 IP** 计数（依赖上面那两个代理列表配对正确），
#   状态在 Redis 里。
# 20 次 / 60 秒：一个正常用户一分钟内不会登录 20 次以上；
#   超过就是脚本在刷。触发后会话短暂被锁 —— 正常用户碰不到这个量。
STASHBOX_LOGIN_RATE_LIMIT=20
# 窗口长度（秒）。
STASHBOX_LOGIN_RATE_WINDOW=60

# ─────────────────────────────────────────────────────────────────────
# 对象存储：阿里云 OSS（走 S3 兼容端点）
# ─────────────────────────────────────────────────────────────────────
# 必填。oss = 阿里云 OSS；local = 本地磁盘（**仅本地开发**）。
#   2 GiB 机器上必须 oss：本地盘放音频，40 GB 系统盘会被音频吃光，
#   而且多副本/重启后音频互相看不到。
STORAGE_PROVIDER=oss

# 必填。S3 兼容 endpoint（不带 https:// 前缀，boto3 会自己补 scheme）。
#
# ⚠️ 内网端点 = 同地域访问，**不产生公网流量费**（出方向流量费 0）。
#    代价：内网端点**只能从同地域的 VPC 内部访问**。
#
# ⚠️ 关于地域的坑（**已按实测修正**）：
#
#   这台轻量服务器的真实地域是 **cn-wuhan-lr（华中1 武汉 · 本地地域）**，
#   不是从 IP 归属查出来的「杭州」—— 阿里云的公网 IP 段按注册地分配，
#   查 IP 归属地会得到误导性的结果。**唯一可靠的判据是云元数据**：
#     curl http://100.100.100.200/latest/meta-data/region-id
#
#   OSS 端点必须与机器同地域才能用内网。实测（本机 curl）：
#     oss-cn-wuhan-lr-internal   ✅ 可连（100.115.89.x，本地域）
#     oss-cn-hangzhou-internal   ❌ 连不上（跨地域内网，解析得到但流量出不去）
#     oss-cn-hangzhou            ✅ 可连（公网，但出方向按流量计费）
#
#   → 两种正确配法，二选一：
#       (a) bucket 建在 **oss-cn-wuhan-lr**，用内网端点
#           oss-cn-wuhan-lr-internal.aliyuncs.com —— 服务端与 OSS 流量费 0。
#           ⚠️ 但「本地地域」的 bucket 有额外限制（可用区绑定、存储类型），
#              建桶前先在控制台确认你的账号能不能在这个地域建标准存储桶。
#       (b) bucket 建在 **oss-cn-hangzhou**，用**公网**端点
#           oss-cn-hangzhou.aliyuncs.com —— 一定能用，
#           但服务端与 OSS 之间的出方向流量按公网计费。
#           内测量级的音频流量不大，费用可接受。
#
#   ⚠️ 注意：本地地域的 OSS 端点是 `oss-cn-wuhan-lr`（带 -lr 后缀），
#      **不是** `oss-cn-wuhan` —— 后面那个在公网 DNS 根本没有 A 记录。
#
#   · preflight.sh 会读云元数据自动比对机器地域与 bucket 地域（#7）。
OSS_ENDPOINT=oss-cn-wuhan-lr-internal.aliyuncs.com
# 必填。bucket 名（地域要和 OSS_ENDPOINT 对得上）。
OSS_BUCKET=
# 必填。AccessKey ID。
OSS_ACCESS_KEY_ID=
# 必填。AccessKey Secret。
OSS_ACCESS_KEY_SECRET=
# 选填。签名用 region，**必须与 bucket 所在地域一致**。
#   ⚠️ 代码默认值是 us-east-1（对阿里云是错的）—— 配错会在上传时签名失败。
OSS_REGION=oss-cn-wuhan-lr
# 选填。公网可访问的 base url（CDN 域名）。
#   ⚠️ 客户端（安卓端）从公网拉音频，走的是这个地址 —— 它是给**客户端**用的，
#   所以这里用公网域名，服务端上传/下载才用 OSS_ENDPOINT。
#   ⚠️ 本地地域的 bucket 走公网域名可能受地域限制，若不通则改用
#      杭州 bucket + 杭州公网端点（方案 b）。
OSS_PUBLIC_BASE_URL=
# 选填。预签名 URL 有效期（秒）。
OSS_PRESIGN_EXPIRES=86400

# ── 本地音频存储（只有 STORAGE_PROVIDER=local 时才用得上）────────────
#
# ⚠️ LOCAL_AUDIO_DIR 是 **base_dir**，storage 的 key 会拼在它后面。
#    蒸馏写盘的 key 是 `audio/{article_id}.mp3`（自带 audio/ 前缀），
#    所以 base_dir **不能**再带 audio/ —— 否则会存成
#    /var/lib/stashbox/data/audio/audio/xxx.mp3（多一层），
#    而对外 URL 仍按 LOCAL_STORAGE_PUBLIC_URL + key 拼，
#    两者对不上就下载不到。
#
#    正确：LOCAL_AUDIO_DIR=/var/lib/stashbox/data
#          → 文件落在 /var/lib/stashbox/data/audio/{id}.mp3
#    配错：LOCAL_AUDIO_DIR=/var/lib/stashbox/data/audio
#          → 文件落在 .../data/audio/audio/{id}.mp3
LOCAL_AUDIO_DIR=/var/lib/stashbox/data
# 本地存储对外 URL。nginx 把 /audio/ 转给网关，网关的静态路由挂在 /audio，
# 而 key 又是 audio/xxx.mp3 → 完整地址是 {这个}/audio/{id}.mp3。
LOCAL_STORAGE_PUBLIC_URL=https://api.stashbox.cn/audio
# 选填。网关是否挂 /audio 静态路由。
#   STORAGE_PROVIDER=local 时**自动挂**（见 api-gateway/main.py），
#   这里的开关是给"用 oss 存但想在网关本地也留一份"这种场景用的。
ENABLE_LOCAL_AUDIO_MOUNT=0

# ─────────────────────────────────────────────────────────────────────
# TTS（蒸馏 Step3）
# ─────────────────────────────────────────────────────────────────────
# 必填。provider：openai / doubao / edge / indextts / mock / local。
#
# ⚠️ 2 GiB 机器上用 **edge**：
#   · edge-tts 已经是依赖（pyproject.toml），**不需要 API key**；
#   · 它**不加载任何模型** → 不吃 RAM（本机没有 torch/transformers/onnx，
#     蒸馏链路上也没有任何模型权重）；
#   · 代价：音色是微软的在线音色，不能自定义音色、不能离线。
#   · indextts **不能**在本机跑：自建 IndexTTS 服务（infra/mlx-audio-tts-service）
#     是 **macOS/mlx 专属**，Ubuntu 上跑不起来，而且它要加载模型（几个 GB RAM）。
#     但 indextts 这个 provider **仍然可用**：把 INDEXTTS_BASE_URL 指向
#     另一台（远程）IndexTTS 主机即可 —— 那样模型在那台机器上，不占本机内存。
#     前提是那台机器在网络可达的位置。
TTS_PROVIDER=edge
# TTS_PROVIDER=edge 时生效（免费、无需 key）。
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# 选填。全局 TTS 并发上限，默认 8。
#   2 vCPU 上降到 4：edge-tts 是纯网络 I/O，但并发越高瞬时内存越高。
TTS_MAX_CONCURRENT=4

# TTS_PROVIDER=openai 时生效（OpenAI 协议的 TTS 端点）。
#
# ⚠️ **长稿分段合成的参数**（2026-10-21 加，见 app/services/tts/openai.py）：
#   端点不截断，但整篇合成会撞上 httpx 的固定 60s 超时 —— 实测
#   ~500 字 → 40s 成功，~1047 字 → 60s 超时失败。
#   所以长稿按句读边界切块后逐块合成。
#
#   OPENAI_TTS_CHUNK_CHARS：单块最大字数，默认 300。
#     实测 ~280 字 → 17.4s/块，对 60s 超时有 3.5 倍余量。
#   OPENAI_TTS_CONCURRENCY：分块并发度，默认 **1（串行）**。
#     ⚠️ 不要为了「快」调高：实测上游是**串行处理**的，并发 1/2/4
#     的总耗时几乎一样（54.2s / 51.1s / 53.4s），并发零吞吐收益；
#     反而让末段在队列里等 ~53s 才轮到处理，撞上 60s 超时
#     （生产实跑确实这么炸过：4 段并发，第 4 段超时，整篇蒸馏失败）。
OPENAI_TTS_CHUNK_CHARS=300
OPENAI_TTS_CONCURRENCY=1

# TTS_PROVIDER=indextts 时生效（**远程** IndexTTS 主机，不是本机）。
#   选填。端点。
INDEXTTS_BASE_URL=
# 选填。模型名。
INDEXTTS_MODEL=Qwen3-TTS-12Hz-0.6B-Base-bf16
# 选填。参考音频路径（远程主机上的路径；本机不用）。
INDEXTTS_REF_AUDIO=
# 选填。参考音频对应文本。
INDEXTTS_REF_TEXT=
# 选填。整体超时（秒），默认 300。
INDEXTTS_TIMEOUT=300
# 选填。分片超时（秒），默认 90。
INDEXTTS_CHUNK_TIMEOUT=90
# 选填。分片字符数，默认 200。
INDEXTTS_CHUNK_CHARS=200
# 选填。分片并发，默认 1。
INDEXTTS_CONCURRENCY=1
# 选填。失败重试次数，默认 2。
INDEXTTS_MAX_ATTEMPTS=2
# 选填。故障转移端点列表（逗号分隔）。
INDEXTTS_FAILOVER_URLS=
# 选填。熔断阈值，默认 3。
INDEXTTS_BREAKER_THRESHOLD=3
# 选填。熔断冷却（秒），默认 300。
INDEXTTS_BREAKER_COOLDOWN=300
# 选填。生成的中间音频目录（本机可写目录）。
INDEXTTS_AUDIO_DIR=/var/lib/stashbox/data/audio

# 必填（生产）。ffmpeg 可执行文件路径。
#   ai-service/distill/steps.py 与 audio_variant_service.py 都真的 fork 它。
#   ⚠️ 代码默认值是 macOS 的 /opt/homebrew/bin/ffmpeg，这里必须指向
#      Ubuntu 的 /usr/bin/ffmpeg（tune-host.sh --install-deps 已装）。
#   实测：4MB WAV → 64kbps AAC 峰值 RSS 18 MB、墙钟 0.35 s —— CPU 不是瓶颈。
FFMPEG_BIN=/usr/bin/ffmpeg

# ─────────────────────────────────────────────────────────────────────
# LLM（蒸馏 Step1 结构化 / Step2 改写）
# ─────────────────────────────────────────────────────────────────────
# 必填。provider：openai / qwen_vl / mock。生产**不要用 mock**。
LLM_PROVIDER=openai
# 选填。请求超时（秒），默认 60。
LLM_TIMEOUT=60
# 选填。失败重试次数，默认 3。
LLM_MAX_RETRIES=3
# LLM_PROVIDER=openai 时生效。
#
# ⚠️ **这个可以不填** —— 管理后台「LLM 设置」配的 key 优先级更高
#    （运行时 DB > env，见 ai-service/llm/factory.py:reload()），
#    而且**改完立即生效，不用重启服务**（蒸馏任务启动前会自动 reload）。
#    preflight.sh 也会同时查 env 和 DB，两处任一有 key 就算通过。
#
#    两种用法：
#    · 运维在后台配（推荐）→ 这里留空即可
#    · 写进 env 当兜底（服务器被重装/换机时不依赖 DB 里的值）
OPENAI_LLM_API_KEY=
# 选填。OpenAI 兼容端点 base_url。
OPENAI_LLM_BASE_URL=https://api.openai.com/v1
# 选填。模型名。
OPENAI_LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=qwen_vl 时生效（阿里 token-plan / 百炼，OpenAI 兼容）。
DASHSCOPE_API_KEY=
QWEN_VL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3.6-flash

# ─────────────────────────────────────────────────────────────────────
# Arq worker（蒸馏队列）
# ─────────────────────────────────────────────────────────────────────
# ⚠️ 2 GiB 专用：默认 4 → **2**。
#   这台机器只有 2 vCPU。并发 4 意味着 4 个蒸馏任务同时跑 ——
#   4 份 LLM 解析 + 4 份音频缓冲 + ffmpeg 抢占 CPU，延迟翻倍，
#   内存峰值也翻倍。2 是这台机器的合理上限。
#   队列本身不受影响（任务排队，只是慢一点）。
ARQ_MAX_JOBS=2
# 选填。单任务超时（秒），默认 1800。
ARQ_JOB_TIMEOUT=1800
# 选填。任务结果保留（秒），默认 86400。
#   降到 3600：Redis 里少存 23 小时的垃圾结果（maxmemory 只有 96mb）。
ARQ_RESULT_TTL=3600
# 选填。失败重试次数（不含首次执行），默认 2。
ARQ_RETRY_MAX=2

# ─────────────────────────────────────────────────────────────────────
# 剪藏抓取（content-service）
# ─────────────────────────────────────────────────────────────────────
# 选填。整条降级链总时限（秒），默认 30。同步接口，用户盯着转圈等。
STASHBOX_CAPTURE_FETCH_BUDGET=30
# ⚠️ 2 GiB 专用：**关掉**无头浏览器通道（默认是 1）。
#   playwright 的 chromium 是 content-service 的子进程，会被算进同一个 cgroup，
#   实测 RSS 300 MB+ —— 在 2 GiB 的机器上，这一个进程就能吃掉
#   content-service 的整个 MemoryMax（224M），必然被 OOM kill，
#   而且它一死整条剪藏链路跟着垮。
#   代价：**必须执行 JS 才有正文的页面抓不到**（实测同一页面纯 HTTP 只抽出 7 个字），
#   这类页面会剪藏失败。普通文章页（服务端渲染）不受影响。
#   要开的话：STASHBOX_FETCH_BROWSER_TIER=1 + 把 content-service 的
#   MemoryMax 提到 640M + 还得从别处腾出 400M —— 2 GiB 的机器上这笔账不成立。
#   （另外记得 `playwright install chromium` 会往磁盘写 ~150MB。）
STASHBOX_FETCH_BROWSER_TIER=0
# 选填。HTTP 通道退避重试次数（默认 2）。
STASHBOX_FETCH_RETRY_ATTEMPTS=2
# 选填。退避基础秒数（默认 0.6，full jitter）。
STASHBOX_FETCH_RETRY_BASE_DELAY=0.6
# 选填。同一 host 两次请求最小间隔（秒，默认 0.3）。
STASHBOX_FETCH_HOST_INTERVAL=0.3

# ─────────────────────────────────────────────────────────────────────
# ai-service 杂项
# ─────────────────────────────────────────────────────────────────────
# 选填。蒸馏 agent 路由模式：rules / llm。默认 rules。
AGENT_ROUTER_MODE=rules
# 选填。路由模型 max tokens，默认 64。
AGENT_ROUTER_MAX_TOKENS=64
# 选填。路由模型温度，默认 0.0。
AGENT_ROUTER_TEMPERATURE=0.0
# 选填。是否启用 agent 的 MCP 工具。默认 0。
ENABLE_MCP_TOOLS=0
# 选填。蒸馏 stage 缓存开关，默认开。
STAGE_CACHE_ENABLED=true
# 选填。蒸馏失败自动重试，默认开。
AUTO_RETRY_ENABLED=true

# ─────────────────────────────────────────────────────────────────────
# 推送投递 / 应用内更新 / 管理后台初始密码
# ─────────────────────────────────────────────────────────────────────
# 选填。厂商无关的 HTTP 网关地址。配了 → 推送真的会发出去；
#   没配 → 系统如实标记 "failed：未配置推送通道"，不是假装已发送。
# STASHBOX_PUSH_WEBHOOK_URL=
# STASHBOX_PUSH_WEBHOOK_TOKEN=
# STASHBOX_PUSH_WEBHOOK_TIMEOUT=10

# 应用内更新（安卓端 GET /api/v1/app/version）。
#
# ⚠️ 每次发版都要改这里的 4 个值 + 重启 user-service。
#    不配的话 App 内"检查更新"会显示"已是最新"，永远提示不了升级。
#
# 版本号要跟 APK 里的对得上（app/build.gradle.kts 的 versionCode/versionName）。
# STASHBOX_APP_LATEST_VERSION_CODE=2
# STASHBOX_APP_LATEST_VERSION_NAME=0.2.0
#
# 最低支持版本：**大于**这个版本的 App 会被强制更新。
# 内测期先保持 0（= 不强制），等有 bug 版本了再往上调。
# STASHBOX_APP_MIN_SUPPORTED_VERSION_CODE=0
#
# APK 下载地址（**公网可达**）。
#   内测最省事的做法：把 APK 传到服务器，让 nginx 静态托管 ——
#   nginx.conf 里已有 location /downloads/ 指向 /var/www/stashbox-downloads。
#     sudo mkdir -p /var/www/stashbox-downloads
#     sudo cp app-release.apk /var/www/stashbox-downloads/tingxia-0.2.0.apk
#   然后：
# STASHBOX_APP_DOWNLOAD_URL=https://api.stashbox.cn/downloads/tingxia-0.2.0.apk
#
# ⚠️ 这个 URL 会发给**任何人**（公开端点，未登录也能查），
#    所以别把内部测试包放上去。
# STASHBOX_APP_DOWNLOAD_URL=
#
# 更新说明（展示在弹窗里）。
# STASHBOX_APP_RELEASE_NOTES=
#
# 发布时间（ISO 8601，显示用）。
# STASHBOX_APP_PUBLISHED_AT=

# 必填。alembic/versions/0015 给 admin 账号种初始密码。
#   优先读这个变量，否则用**代码里写死的 dev 密码** 'admin@stashbox123'
#   → 任何人都能登录运营后台。生成：openssl rand -base64 18
# ⚠️ 只在**首次**迁移（email/password_hash 为 NULL）时生效。
ADMIN_BOOTSTRAP_PASSWORD=

# 选填。管理后台的 LLM / TTS 测试端点开关（代码默认开）。
#
# ⚠️ **内测期保持 1（开）**。关掉的话，后台「LLM 设置」「TTS 设置」页面的
#    「测试调用」按钮会直接 404（端点被 NotFound 掉了），运营点一下只看到
#    一个没有解释的错误 —— 看起来像"后台坏了"，实际是开关关了。
#    风险是"点一次烧一点钱"，但这个端点需要 admin 鉴权，
#    且测试请求本身很小（一次 chat / 一次短 TTS）。
#    真正要防的是"误点很多次"，那属于运营习惯问题，不是开关能解决的。
ENABLE_LLM_TEST_ENDPOINT=1
ENABLE_TTS_TEST_ENDPOINT=1

# ─────────────────────────────────────────────────────────────────────
# 可观测性：**阿里云云监控 / SLS**，不是本机 Prometheus
# ─────────────────────────────────────────────────────────────────────
# LANGFUSE_ENABLED=false
#   2 GiB 机器上不引第二套埋点后端：观测走阿里云云监控 + SLS（见下）。
#   langfuse SDK 是惰性 import，false 时只是几个薄壳，不吃 RAM ——
#   这一项关掉纯粹是为了少一个外部依赖和一份密钥。
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ═════════════════════════════════════════════════════════════════════
# 监控方案（本机**不跑** Prometheus + Grafana）
# ═════════════════════════════════════════════════════════════════════
#
# ❌ 不装：prometheus + grafana + alertmanager + blackbox_exporter +
#         redis_exporter —— 合计约 400-500 MB，2 GiB 机器的四分之一，
#         而唯一的消费者是"一天看一次图"的人。
#   infra/docker/docker-compose.observability.yml 是**本地开发**用的，
#   原样保留，**不要**在这台机器上起。
#   （本机也不该装 Docker 守护进程：空载 150-200 MB + overlay2 存第二份层。）
#
# ✅ 用：阿里云 云监控 / SLS
#   · 云监控（CloudMonitor）：轻量服务器自带 agent，CPU/内存/磁盘/网络指标
#     在控制台直接看，配告警（磁盘 >80%、内存 >90%、负载 >1.5）。
#   · SLS（Log Service）：收集 systemd journal，在 SLS 上做查询与告警
#     （5xx 比例、登录失败率、蒸馏队列积压、worker 重启次数）。
#     采集方式：装 aliyun-log-journald（把 journal 投到 SLS），
#     或让 SLS 的采集器拉 journal。
#   · 应用指标：各服务已经挂了 /metrics（common/observability.py），
#     worker 的 metrics 在 127.0.0.1:8104。要采集就用**远程**采集器
#     （云监控自定义指标 / Managed Prometheus / SLS 采集），
#     **不要**在本机跑 Prometheus —— 本机的 /metrics 只监听回环，
#     远程采集器从 VPC 内来拉即可。
# ═════════════════════════════════════════════════════════════════════

# ═════════════════════════════════════════════════════════════════════
# 下面这两个**故意不写**。写了就等于把后门打开，别为了"能跑起来"加它们。
#
#   STASHBOX_ALLOW_DEV_JWT=1
#       common/config.py：只有它存在，JWT_SECRET 才允许用 dev 默认值。
#       生产配了 = 任何人可以伪造任意用户的 token。绝不配。
#
#   STASHBOX_ALLOW_DEV_TOKEN=1
#       api-gateway：打开 POST /api/v1/auth/token —— 无鉴权签发任意 user_id 的 token。
#       等同任意账号接管。绝不配。
#
# （这两个变量都是"存在即生效"，连写 0 都会打开开关 —— 所以这里一个都不写。）
# ═════════════════════════════════════════════════════════════════════
