[Unit]
Description=Stashbox ai-service（蒸馏服务 / LLM / TTS，127.0.0.1:8103）
Documentation=file:///opt/stashbox/stashbox/backend/deploy/README.md
After=network-online.target stashbox-migrate.service
Wants=network-online.target
Requires=stashbox-migrate.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=stashbox
Group=stashbox
WorkingDirectory=/opt/stashbox/stashbox/backend/ai-service
# EnvironmentFile 把 env 文件里的全部变量送进进程环境，包括
# FORWARDED_ALLOW_IPS（uvicorn 的 ASGI 层）与 TRUSTED_PROXY_IPS（应用层
# backend/common/ip.py）—— 这两个是同一个信任决定的两个实现，必须完全一致
# （preflight.sh 会查）。unit 不传 --forwarded-allow-ips，否则命令行会覆盖
# 环境变量里的 FORWARDED_ALLOW_IPS。
EnvironmentFile=/etc/stashbox/stashbox.env
Environment=PYTHONPATH=/opt/stashbox
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONFAULTHANDLER=1
Environment=MALLOC_ARENA_MAX=2
Environment=TMPDIR=/var/lib/stashbox/tmp
ExecStart=/opt/stashbox/stashbox/backend/deploy/systemd/run-service.sh ai-service 8103
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
OOMPolicy=stop

# ── 内存 / CPU 上限 ────────────────────────────────────────────────────
# 实测：空闲 17-40 MB，80 并发下 60-90 MB。它比网关多两样占内存的东西：
#   1) LLM 响应体（蒸馏 Step1/Step2 的 JSON 可以很大）；
#   2) 音频缓冲（ffmpeg 中间文件虽然落盘，但解码后的 PCM 在内存里）。
#   MemoryHigh=144M —— 给音频/LLM 峰值留出余量。
#   MemoryMax=200M —— 约 2.2× 实测峰值。
#
# ⚠️ 本机没有 torch / transformers / onnx，蒸馏不加载任何模型，
#    所以这 200M 是**服务进程的**上限，不含模型权重。
#    （langgraph / langfuse / mcp 是惰性 import，只占磁盘不占 RAM。）
#
# ⚠️ 物理内存实测只有 1613MB（标称 2 GiB），原 192M/256M 是按 2048MB 算的，
#    五个单元 + PG + Redis + nginx 的硬上限之和必须 ≤ 物理内存，
#    否则同时顶满会触发 cgroup OOM killer（可能杀掉 PG → 整机掉线）。
MemoryHigh=144M
MemoryMax=200M
# 40%：LLM 响应的 JSON 解析 + 音频拼接过渡，CPU 用量比网关/用户服务高。
CPUQuota=40%
TasksMax=256

# ── 加固 ────────────────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
# ReadWritePaths（由 tune-host.sh 创建；带 `-` 的目录不存在时忽略）：
#   /var/lib/stashbox/tmp —— TMPDIR（tempfile）。ffmpeg 的中间文件落这里。
#   /var/log/stashbox      —— 文件日志。
#   /opt/stashbox/stashbox/backend/ai-service/data —— INDEXTTS_AUDIO_DIR 的
#       默认位置（agent/tools.py 往这儿写）。本机 TTS_PROVIDER=edge 用不到，
#       用 `-` 前缀保证它不存在也不影响启动。
ReadWritePaths=/var/lib/stashbox/tmp
ReadWritePaths=/var/log/stashbox
ReadWritePaths=-/opt/stashbox/stashbox/backend/ai-service/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=stashbox-ai-service
