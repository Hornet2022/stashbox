[Unit]
Description=Stashbox content-service（文章 / 待听 / 收藏，127.0.0.1:8102）
Documentation=file:///opt/stashbox/stashbox/backend/deploy/README.md
After=network-online.target stashbox-migrate.service redis-server.service
Wants=network-online.target redis-server.service
Requires=stashbox-migrate.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=stashbox
Group=stashbox
WorkingDirectory=/opt/stashbox/stashbox/backend/content-service
# EnvironmentFile 把 env 文件里的全部变量送进进程环境，包括
# FORWARDED_ALLOW_IPS（uvicorn 的 ASGI 层）与 TRUSTED_PROXY_IPS（应用层
# backend/common/ip.py）—— 这两个是同一个信任决定的两个实现，必须完全一致
# （preflight.sh 会查）。unit 不传 --forwarded-allow-ips，否则命令行会覆盖
# 环境变量里的 FORWARDED_ALLOW_IPS。
EnvironmentFile=/etc/stashbox/stashbox.env
Environment=PYTHONPATH=/opt/stashbox
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONFAULTHANDLER=1
Environment=MALLOC_ARENA_MAX=2
Environment=TMPDIR=/var/lib/stashbox/tmp
ExecStart=/opt/stashbox/stashbox/backend/deploy/systemd/run-service.sh content-service 8102
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
OOMPolicy=stop

# ── 内存 / CPU 上限 ────────────────────────────────────────────────────
# 实测（2026-10-25，修复后，生产连剪 4 次同一篇 17 图微信文）：
#   静息 cgroup current ≈ 93 MiB（其中 anon ≈ 86、file ≈ 10）
#   剪藏峰值     ≈ 127-138 MiB
#   memory.events 的 `high` 增量 = 0（完全不节流）
# 它比别的服务多一样东西：整页 HTML + 解析出来的正文**同时**在内存里
# （几 MB 的页面会变成几十 MB 的 Python 对象）。
#
# ⚠️⚠️ **为什么 MemoryHigh 必须 == MemoryMax（2026-10-25 实测判定）**
#
# cgroup v2 的 memory.high 是**节流**：越过水位线的分配会被内核挡在回收
# 路径上（进程进 D 状态，`wchan=mem_cgroup_handle_over_high`）。后果：
#   ① 请求永不返回；② **整个服务都不响应**（连列表查询也一起超时）；
#   ③ 进程在 D 状态 ⇒ **SIGKILL 都杀不掉** ⇒ 不会自愈、不会告警。
# `memory.events` 里 `high 19414`、`oom 0` ⇒ 「没 OOM」不等于「没事」。
#
# ⇒ 在生产机上用一次性 cgroup 做的对照实验（两种配置各跑一个持续分配的进程）：
#   high=64M  max=128M → 退出码 **124（超时卡死）**，events: high 1477 / oom 0
#                          ⇒ 跨过 high 就**永久冻死**，连 OOM killer 都到不了
#   high=128M max=128M → 退出码 **137（SIGKILL）**，events: high 0 / oom 1
#                          ⇒ high==max 时内核**直接走 OOM 路径**，不节流、不冻死
#
# ⇒ 所以「high < max」那个区间在本机是**死亡陷阱**：跨进去就是挂死，
#   而跨过 max 只是被杀 —— 本单元有 `Restart=always`，被杀会被 systemd
#   拉起来（自愈）。**宁可被杀，不要挂死。**
#
# ⇒ 于是：**High 224M == Max 224M**，把节流区间整个去掉。
#   硬上限没变（还是 224M）⇒ 内存预算表不受影响（MemoryMax 之和仍是 904M）。
#
# ⚠️ 这个数是按「实测峰值」定的，不是拍脑袋：
#   修前（没缩图、没总字节闸）稳态边际成本 +48MB，峰值 181MiB ⇒ 224M 够用；
#   修后峰值 127-138MiB，离 224M 还有 ~90MiB 余量。
#   更大的文章（页更大 / 图更多）会抬高峰值，但再高就是 OOM kill + 自愈，
#   **不会**变成整服务挂死。
#
# 代码侧同时加了内存闸门（识图前缩图 + 单篇配图总字节预算 + 请求后
# malloc_trim 归还碎片，见 fetchers/ocr.py、media_ocr.py 与
# common/middleware/memory_trim.py）—— 闸门是为了**别频繁被杀**，
# 而 high==max 是为了**被杀时能活过来**。
#
# ⚠️ 这里的 224M 之所以够用，是因为**浏览器通道关掉了**
#   （2 GiB 模板里 STASHBOX_FETCH_BROWSER_TIER=0）。
#   playwright 的 chromium 是 content-service 的子进程，会被算进同一个 cgroup，
#   实测 RSS 300 MB+ —— 开着浏览器通道的话，这个单元必然被 OOM kill，
#   而且它会连带把整个剪藏链路拖垮。
#   要开浏览器通道：先把 STASHBOX_FETCH_BROWSER_TIER 改回 1、
#   再把 MemoryMax 提到 640M，同时从别处（见 deploy/README.md 内存预算表）
#   腾出 400 MB —— 这台机器（物理内存实测 1613MB）上这笔账不成立。
#
# ⚠️ 物理内存实测只有 1613MB（标称 2 GiB），五个单元 + PG + Redis + nginx
#   的**硬上限（MemoryMax）**之和必须 ≤ 物理内存，否则同时顶满会触发
#   cgroup OOM killer（可能杀掉 PG → 整机掉线）。
#   ⇒ 抬到 224M 的同时把 PG 的 MemoryMax 从 320M 收到 288M
#   （见 tune-host.sh），总和仍在 0.85×1613M 以内。
MemoryHigh=224M
MemoryMax=224M
# 35%：抓取 + HTML 解析是纯 CPU 的，但实测剪藏最坏 ~40.6s 里大头是网络等待，
# 不是解析。35% 足够，也保证不跟蒸馏任务抢核。
CPUQuota=35%
TasksMax=256

# ── 加固 ────────────────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
# ReadWritePaths（由 tune-host.sh 创建；带 `-` 的目录不存在时忽略）：
#   /var/lib/stashbox/tmp —— TMPDIR（tempfile）。浏览器通道若开启，
#       STASHBOX_FETCH_BROWSER_STATE 默认落在 tempfile.gettempdir() 下，
#       所以指向这里（而不是被 ProtectSystem 变成只读的 /tmp）。
#   /var/log/stashbox      —— 文件日志。
ReadWritePaths=/var/lib/stashbox/tmp
ReadWritePaths=/var/log/stashbox
ReadWritePaths=-/var/lib/stashbox/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=stashbox-content-service

[Install]
# 开机自启。没有这段，`systemctl enable` 会直接报
# "The unit files have no installation config"，README 里写的
# `systemctl enable --now ...` 引导命令跑不通，服务只靠人工 start 撑着
# —— 机器一重启整套后端就全灭（通知推送、蒸馏 worker 全都停摆）。
#
# multi-user.target 是 nginx / postgresql / redis 所在的同一层级，
# 本组 unit 自己用 Requires/After 排好先后（见 [Unit] 段）。
WantedBy=multi-user.target
