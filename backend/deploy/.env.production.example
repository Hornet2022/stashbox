# Stashbox 后端 —— 生产环境变量模板
# ======================================================================
#
# 用法：
#     cd backend/deploy
#     cp .env.production.example .env.production
#     # 逐项填真值（下面每个变量都标了「必填 / 选填」和「干什么用」）
#     ./preflight.sh          # 自检；任何 FAIL 都别发
#
# ⚠️ 本文件**不含任何真实凭证**，全是空值或明显占位符。
# ⚠️ .env.production 已被仓库根 .gitignore 排除（.env* 规则），
#    但填完之后请自己再确认一次 `git status` 里没有它。
#
# 本文件同时是 compose 的 env_file —— 也就是说它会**整体**进容器环境。
# 所以凡是代码里 os.getenv() / pydantic-settings 会读的变量，都列在这里。
#
# 格式约定：
#   必填 = 缺了服务起不来 / 起得来但功能是坏的（preflight 会 FAIL）
#   选填 = 不填就走代码默认值（preflight 会 WARN）

# ─────────────────────────────────────────────────────────────────────
# 运行环境
# ─────────────────────────────────────────────────────────────────────
# 必填。只能是 dev / staging / prod。
# prod 会触发两处硬门禁：
#   · common/config.py：JWT_SECRET 用默认值直接 ValidationError 退出
#   · api-gateway/main.py：没配 STASHBOX_CORS_ALLOW_ORIGINS 直接 RuntimeError 退出
ENVIRONMENT=prod
# 选填。日志级别：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL=INFO
# 选填。容器时区，默认 Asia/Shanghai。
#   ⚠️ 必须与 RDS 的时区一致，否则应用本地时间与数据库 NOW() 会对不上。
#   compose 会用 ${TZ:-Asia/Shanghai} 兜底；部署到 ACK 时靠这一项。
TZ=Asia/Shanghai
# 必填。生产写 false。true 会让 SQLAlchemy 把每条 SQL 打进日志（慢 + 泄露表结构）。
DEBUG=false

# 必填。JWT 签发密钥，>= 16 字符（建议 32+ 随机串）。
# 生成：openssl rand -hex 32
# ⚠️ 不能是代码里的 dev 默认值 "dev-secret-change-me-in-production"（会被拒绝启动）。
# ⚠️ 换密钥 = 所有已签发 token 立即失效（用户要重新登录）。内测期建议固定，别每次发版都换。
JWT_SECRET=

# 选填。第三方回调（微信公众号服务号 / clawbot 等）的共享密钥。
# 空 = 未配置 → 回调端点一律 503 拒绝（fail-closed，见 common/callback_auth.py）。
# ⚠️ 这类回调没有用户 JWT 可校验，配了就是开一个匿名建文章入口 —— 确认来源可信再配。
CALLBACK_SHARED_SECRET=

# ─────────────────────────────────────────────────────────────────────
# PostgreSQL（托管 RDS）
# ─────────────────────────────────────────────────────────────────────
# ⚠️ 本项目**不读 DATABASE_URL**。common/config.py::Settings.database_url 是
#    由下面 5 个变量现场拼出来的：
#        postgresql+asyncpg://{POSTGRES_USER}:{POSTGRES_PASSWORD}@{POSTGRES_HOST}:{POSTGRES_PORT}/{POSTGRES_DB}
#    配 DATABASE_URL 会被**静默忽略**（应用转去连 localhost 然后失败）。
#
# 必填。RDS 的内网地址（例：rm-xxxx.pg.rds.aliyuncs.com）。
POSTGRES_HOST=
# 必填。RDS 实例端口。
POSTGRES_PORT=5432
# 必填。RDS 账号。
POSTGRES_USER=
# 必填。RDS 密码。
POSTGRES_PASSWORD=
# 必填。数据库名。
POSTGRES_DB=
# 选填。连接池大小（每个进程）。
POSTGRES_POOL_SIZE=10
# 选填。连接回收秒数（躲开 RDS 的空闲断连）。
POSTGRES_POOL_RECYCLE=3600

# ─────────────────────────────────────────────────────────────────────
# Redis（托管 ApsaraDB Redis）
# ─────────────────────────────────────────────────────────────────────
# 必填。Redis 内网地址。
REDIS_HOST=
# 必填。Redis 端口。
REDIS_PORT=6379
# 选填。逻辑库编号。
REDIS_DB=0
# 必填（托管实例通常有密码）。应用拼 redis://[:password@]host:port/db。
REDIS_PASSWORD=
# 必填。Arq worker（ai-service/arq_settings.py）**直接**读这个变量，
#       不看上面的 REDIS_*。必须和上面 4 个指向同一个实例，否则：
#       worker 连的是 A、web 连的是 B → 任务进了队列没人消费，且毫无报错。
#       格式：redis://[:密码@]host:port/db
#       preflight.sh 会逐项比对它和 REDIS_* 是否一致（防漂移）。
REDIS_URL=

# ─────────────────────────────────────────────────────────────────────
# 网关接线
# ─────────────────────────────────────────────────────────────────────
# 选填 / 由 compose 接管。这 3 个是网关 → 下游的地址，
#   compose 的 docker-compose.production.yml 会强制覆盖成容器服务名
#   （http://user-service:8101 等）。code 默认值是 8001/8002/8003 —— 旧端口，
#   容器里监听的是 8101/8102/8103，不覆盖就是 502。
# 部署到 ACK（不用 compose）时才需要自己填。
USER_SERVICE_URL=http://user-service:8101
CONTENT_SERVICE_URL=http://content-service:8102
AI_SERVICE_URL=http://ai-service:8103

# 必填。网关对外可达的地址前缀（客户端拿到的音频 URL 等会拼它）。
# 例：https://api.stashbox.cn
PUBLIC_GATEWAY_URL=

# 必填。跨域白名单，逗号分隔的 origin（不带路径、不带末尾斜杠）。
#   ⚠️ ENVIRONMENT=prod 时不配 → 网关**启动即失败**（这是有意的门禁，
#      默认放行全网等于把运营后台的 cookie 暴露给任意站点）。
#   例：https://admin.stashbox.cn,https://stashbox.cn
STASHBOX_CORS_ALLOW_ORIGINS=

# 选填。网关 → 下游的调用超时（秒），默认 60。
# 必须 > 下游最慢同步端点。剪藏实测最坏 ~40.6s —— 配小了客户端只拿到裸 500。
STASHBOX_GATEWAY_UPSTREAM_TIMEOUT=60

# 必填（生产）。uvicorn --forwarded-allow-ips：只有这些上游传来的
#   X-Forwarded-For 会被采信。网关靠它拿真实客户端 IP（下游登录限流按 IP 计数）。
#   填 SLB / Ingress 的网段，例：10.0.0.0/8
#   ⚠️ 填 "*" = 任何人都能伪造来源 IP 绕过限流 —— preflight 在 prod 下会 FAIL。
#   不确定就先填 127.0.0.1（保守：谁都不信，代价是限流按网关 IP 粗粒度计数）。
TRUSTED_PROXY_IPS=

# ─────────────────────────────────────────────────────────────────────
# 登录限流（user-service）
# ─────────────────────────────────────────────────────────────────────
# 选填。wechat-login 是未鉴权端点：任意 code 都能建号 → 必须限流，
#   否则公网上一次循环就能建出海量账号（每个号自带免费配额）。
#   阈值按 IP 计数，状态在 Redis 里（多副本共享同一份额度）。
# 每个 IP 每个窗口最多尝试次数。
STASHBOX_LOGIN_RATE_LIMIT=20
# 窗口长度（秒）。
STASHBOX_LOGIN_RATE_WINDOW=60

# ─────────────────────────────────────────────────────────────────────
# 推送投递（厂商通道网关）
# ─────────────────────────────────────────────────────────────────────
# 选填。厂商无关的 HTTP 网关地址（极光 / TPNS / 华为 / 小米 … 的自建网关）。
#   配了 → 推送真的会发出去；没配 → 系统如实标记 "failed：未配置推送通道"，
#   而不是假装已发送。留空不影响应用内通知中心。
# STASHBOX_PUSH_WEBHOOK_URL=https://your-push-gateway.example.com/push
# 选填。上面网关的鉴权 token（会放 Authorization 头）。
# STASHBOX_PUSH_WEBHOOK_TOKEN=
# 选填。投递超时（秒），默认 10。
# STASHBOX_PUSH_WEBHOOK_TIMEOUT=10

# ─────────────────────────────────────────────────────────────────────
# 应用内更新（安卓端 GET /api/v1/app/version）
# ─────────────────────────────────────────────────────────────────────
# 选填。改这几个 + 重启 user-service 就能推一版，不需要做管理页面。
# 版本号（整数），客户端拿它和本地比。0 = 不提示更新。
# STASHBOX_APP_LATEST_VERSION_CODE=0
# 版本名（展示用）。
# STASHBOX_APP_LATEST_VERSION_NAME=
# 最低可用版本（整数）。>= 最新版本时接口返回 mandatory=true（强制升级）。
# STASHBOX_APP_MIN_SUPPORTED_VERSION_CODE=0
# 下载地址（客户端点"更新"跳这里）。
# STASHBOX_APP_DOWNLOAD_URL=
# 更新说明。
# STASHBOX_APP_RELEASE_NOTES=
# 发布时间（ISO8601，如 2026-10-21T10:00:00+08:00）。
# STASHBOX_APP_PUBLISHED_AT=

# ─────────────────────────────────────────────────────────────────────
# 管理后台初始密码（迁移 0015）
# ─────────────────────────────────────────────────────────────────────
# 必填。alembic/versions/0015 给 admin 账号种初始密码：
#   优先读这个变量，否则用**代码里写死的 dev 密码** 'admin@stashbox123'。
#   不配 = 运营后台账号密码是公开的 → 任何人都能登录 admin-web。
#   生成：openssl rand -base64 18
# ⚠️ 只在**首次**迁移（email/password_hash 为 NULL）时生效。
#    之后要改密码请走管理后台，不要靠改这个变量（不会重新触发 0015）。
ADMIN_BOOTSTRAP_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# Arq worker（蒸馏队列）
# ─────────────────────────────────────────────────────────────────────
# 选填。并发 worker 数（同时跑几个蒸馏任务）。默认 4。
ARQ_MAX_JOBS=4
# 选填。单任务超时（秒），默认 1800（30 分钟）。
ARQ_JOB_TIMEOUT=1800
# 选填。任务结果保留（秒），默认 86400（1 天）。
ARQ_RESULT_TTL=86400
# 选填。失败重试次数（不含首次执行），默认 2。
ARQ_RETRY_MAX=2

# ─────────────────────────────────────────────────────────────────────
# LLM（蒸馏 Step1 结构化 / Step2 改写）
# ─────────────────────────────────────────────────────────────────────
# 必填。provider：openai / qwen_vl / mock。
#   ⚠️ 生产**不要用 mock**（不会真的生成内容）。
LLM_PROVIDER=openai
# 选填。请求超时（秒），默认 60。
LLM_TIMEOUT=60
# 选填。失败重试次数，默认 3。
LLM_MAX_RETRIES=3

# LLM_PROVIDER=openai 时生效。
# 必填。OpenAI 兼容端点的 key（也兼容火山方舟 / token-plan 等 OpenAI 协议栈）。
OPENAI_LLM_API_KEY=
# 选填。OpenAI 兼容端点 base_url。
OPENAI_LLM_BASE_URL=https://api.openai.com/v1
# 选填。模型名。
OPENAI_LLM_MODEL=gpt-4o-mini

# LLM_PROVIDER=qwen_vl 时生效（阿里 token-plan / 百炼，OpenAI 兼容）。
# 必填。key。
DASHSCOPE_API_KEY=
# 选填。端点。
QWEN_VL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 选填。模型名。
QWEN_VL_MODEL=qwen3.6-flash

# 选填。common/config.py 里的旧字段，保留兼容；LLM 工厂实际读上面那组。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com

# ─────────────────────────────────────────────────────────────────────
# TTS（蒸馏 Step3）
# ─────────────────────────────────────────────────────────────────────
# 必填。provider：openai / doubao / edge / indextts / mock / local。
#   ⚠️ 生产不要用 mock（不产音频）。
#   ⚠️ indextts 指向的是自建服务（infra/mlx-audio-tts-service），**macOS 专属**，
#      不能在 Linux 容器里跑 —— 生产用 openai / doubao / edge，或把 TTS 单独部署。
TTS_PROVIDER=openai
# 选填。全局 TTS 并发上限，默认 8。
TTS_MAX_CONCURRENT=8

# TTS_PROVIDER=openai 时生效（OpenAI 协议：OpenAI / Azure / 火山方舟 ARK）。
# 必填。key。
OPENAI_TTS_API_KEY=
# 选填。base_url。
OPENAI_BASE_URL=https://api.openai.com/v1
# 选填。模型。
OPENAI_TTS_MODEL=tts-1
# 选填。音色。
OPENAI_TTS_VOICE=alloy

# TTS_PROVIDER=doubao 时生效（火山方舟 Coding Plan）。
# 必填。key（X-Api-Key）。
DOUBAO_TTS_API_KEY=
# 选填。旧版 token。
DOUBAO_TTS_TOKEN=
# 选填。旧版 app_id。
DOUBAO_TTS_APP_ID=
# 选填。音色 speaker id（不是 BV001_streaming 那种占位）。
DOUBAO_TTS_VOICE=
# 选填。资源 id。
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0

# TTS_PROVIDER=edge 时生效（免费、无需 key）。
# 选填。音色。
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# TTS_PROVIDER=indextts 时生效（自建服务）。
# 选填。端点。
INDEXTTS_BASE_URL=http://127.0.0.1:8010/v1
# 选填。模型名。
INDEXTTS_MODEL=Qwen3-TTS-12Hz-0.6B-Base-bf16
# 选填。参考音频路径（容器内路径，或挂载卷里的路径）。
INDEXTTS_REF_AUDIO=
# 选填。参考音频对应文本。
INDEXTTS_REF_TEXT=
# 选填。整体超时（秒），默认 300。
INDEXTTS_TIMEOUT=300
# 选填。分片超时（秒），默认 90。
INDEXTTS_CHUNK_TIMEOUT=90
# 选填。分片字符数，默认 200。
INDEXTTS_CHUNK_CHARS=200
# 选填。分片并发，默认 1。
INDEXTTS_CONCURRENCY=1
# 选填。失败重试次数，默认 2。
INDEXTTS_MAX_ATTEMPTS=2
# 选填。故障转移端点列表（逗号分隔）。
INDEXTTS_FAILOVER_URLS=
# 选填。熔断阈值，默认 3。
INDEXTTS_BREAKER_THRESHOLD=3
# 选填。熔断冷却（秒），默认 300。
INDEXTTS_BREAKER_COOLDOWN=300
# 选填。生成的中间音频目录（容器内可写）。
INDEXTTS_AUDIO_DIR=/app/stashbox/backend/ai-service/data/audio

# TTS_PROVIDER=local 时生效（macOS `say`，Linux 容器里不可用）。
# 选填。
TTS_LOCAL_VOICE=Tingting

# 必填（生产）。ffmpeg 可执行文件路径。
#   代码里 app/services/tts 的默认值是 macOS 的 /opt/homebrew/bin/ffmpeg，
#   容器里必须指向 /usr/bin/ffmpeg，否则拼音频 / 多码率转码全断。
#   ai-service/distill/steps.py 与 audio_variant_service.py 都真的 fork 它。
FFMPEG_BIN=/usr/bin/ffmpeg

# ─────────────────────────────────────────────────────────────────────
# 对象存储（生产 = 阿里云 OSS，走 S3 兼容端点）
# ─────────────────────────────────────────────────────────────────────
# 必填。oss = 阿里云 OSS（S3 兼容）；local = 本地磁盘（**仅本地开发**）。
# ⚠️ 生产必须 oss。历史上生产 .env 漏了这一行，storage 工厂取默认 oss 去
#    本地盘找音频 → 多码率转码 100% 静默失败。
STORAGE_PROVIDER=oss
# 必填。S3 兼容 endpoint。阿里云 OSS：oss-cn-hangzhou.aliyuncs.com
#   （注意：不带 https:// 前缀，boto3 会自己补 scheme；本机 SeaweedFS 是 http://127.0.0.1:8333）
OSS_ENDPOINT=
# 必填。bucket 名。
OSS_BUCKET=
# 必填。AccessKey ID。
OSS_ACCESS_KEY_ID=
# 必填。AccessKey Secret。
OSS_ACCESS_KEY_SECRET=
# 选填。公网可访问的 base url（如 CDN 域名）。配了就直接拼进 audio_url。
OSS_PUBLIC_BASE_URL=
# 选填。签名用 region，必须与 bucket 所在地域一致（阿里云 OSS：oss-cn-hangzhou）。
#   ⚠️ 代码默认值是 us-east-1（对阿里云是错的）—— 配错会在上传时签名失败。
OSS_REGION=oss-cn-hangzhou
# 选填。预签名 URL 有效期（秒），默认 86400。
OSS_PRESIGN_EXPIRES=86400

# 选填。本地音频目录（STORAGE_PROVIDER=local 时用）。
#   compose 里已改成 /var/audio（容器内的可写目录）。
LOCAL_AUDIO_DIR=/var/audio
# 选填。本地存储对外 URL（不配则用 PUBLIC_GATEWAY_URL 拼）。
LOCAL_STORAGE_PUBLIC_URL=
# 选填。网关是否挂 /audio 静态路由。生产写 0（音频在 OSS，网关只透传 URL）。
ENABLE_LOCAL_AUDIO_MOUNT=0

# ─────────────────────────────────────────────────────────────────────
# 剪藏抓取（content-service）
# ─────────────────────────────────────────────────────────────────────
# 选填。整条降级链总时限（秒），默认 30。同步接口，用户盯着转圈等，超时他会认定应用坏了。
STASHBOX_CAPTURE_FETCH_BUDGET=30
# 选填。无头浏览器通道开关（默认 1）。关掉后退回纯 HTTP，
#   JS 渲染页会抓不到正文（实测同一页面纯 HTTP 只抽到 7 个字）。
#   需要镜像里装了 playwright chromium（compose 的 content-service 有）。
STASHBOX_FETCH_BROWSER_TIER=1
# 选填。HTTP 通道退避重试次数（默认 2）。404 这类确定性失败绝不重试。
STASHBOX_FETCH_RETRY_ATTEMPTS=2
# 选填。退避基础秒数（默认 0.6，full jitter）。
STASHBOX_FETCH_RETRY_BASE_DELAY=0.6
# 选填。同一 host 两次请求最小间隔（秒，默认 0.3）。主动限速保住长期成功率。
STASHBOX_FETCH_HOST_INTERVAL=0.3
# 选填。显式代理（IP 级封锁的逃生口）。默认不配 —— 采购住宅代理是产品决定。
# STASHBOX_FETCH_PROXY=

# ─────────────────────────────────────────────────────────────────────
# ai-service 杂项
# ─────────────────────────────────────────────────────────────────────
# 选填。蒸馏 agent 路由模式：rules / llm。默认 rules。
AGENT_ROUTER_MODE=rules
# 选填。路由模型 max tokens，默认 64。
AGENT_ROUTER_MAX_TOKENS=64
# 选填。路由模型温度，默认 0.0。
AGENT_ROUTER_TEMPERATURE=0.0
# 选填。是否启用 agent 的 MCP 工具。默认 0。
ENABLE_MCP_TOOLS=0
# 选填。蒸馏 stage 缓存开关，默认开。
STAGE_CACHE_ENABLED=true
# 选填。蒸馏失败自动重试，默认开。
AUTO_RETRY_ENABLED=true

# ─────────────────────────────────────────────────────────────────────
# 可观测性（可选）
# ─────────────────────────────────────────────────────────────────────
# 选填。Langfuse 蒸馏链路埋点；不配默认关闭。
LANGFUSE_ENABLED=false
# 选填。
LANGFUSE_PUBLIC_KEY=
# 选填。
LANGFUSE_SECRET_KEY=
# 选填。
LANGFUSE_HOST=https://cloud.langfuse.com

# ─────────────────────────────────────────────────────────────────────
# 管理后台的联调端点
# ─────────────────────────────────────────────────────────────────────
# 选填。管理后台的 LLM / TTS 测试端点开关。代码默认是 **开**（"1"）。
#   生产建议关掉（写 0）：这两个端点会真的调 LLM/TTS 烧钱。
ENABLE_LLM_TEST_ENDPOINT=0
ENABLE_TTS_TEST_ENDPOINT=0

# ═════════════════════════════════════════════════════════════════════
# 下面这两个**故意不写**。写了就等于把后门打开，别为了"能跑起来"加它们。
#
#   STASHBOX_ALLOW_DEV_JWT=1
#       common/config.py：只有它存在，JWT_SECRET 才允许用 dev 默认值。
#       生产配了 = 任何人可以伪造任意用户的 token。绝不配。
#
#   STASHBOX_ALLOW_DEV_TOKEN=1
#       api-gateway：打开 POST /api/v1/auth/token —— 无鉴权签发任意 user_id 的 token。
#       等同任意账号接管。绝不配。
#
# （这两个变量都是"存在即生效"，连写 0 都会打开开关 —— 所以这里一个都不写。）
# ═════════════════════════════════════════════════════════════════════
